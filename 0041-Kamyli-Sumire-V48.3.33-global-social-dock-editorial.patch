@@ -0,0 +1,234 @@
+/* =========================================================
+   REDES SOCIAIS GLOBAIS — V48.3.33
+   Dock em desktop/tablet; botão expansível no mobile.
+   ========================================================= */
+
+.site-socials {
+    position: fixed;
+    z-index: 850;
+
+    pointer-events: none;
+
+    transition: opacity .18s ease;
+}
+
+.site-socials-desktop {
+    position: fixed;
+    top: 50%;
+    right: max(12px, env(safe-area-inset-right));
+
+    display: flex;
+    flex-direction: column;
+    gap: 7px;
+
+    padding: 7px;
+
+    background-color: var(--nav-bg);
+    border: 1px solid var(--card-border);
+    border-radius: 999px;
+    box-shadow: var(--shadow-card);
+
+    backdrop-filter: blur(var(--blur-card));
+    -webkit-backdrop-filter: blur(var(--blur-card));
+
+    transform: translateY(-50%);
+    pointer-events: auto;
+}
+
+.site-social-link,
+.site-socials-mobile-trigger,
+.site-socials-mobile-link {
+    color: var(--primary-color);
+    background-color: var(--card-bg);
+    border: 1px solid var(--card-border);
+
+    text-decoration: none;
+
+    transition:
+        color .18s ease,
+        background-color .18s ease,
+        border-color .18s ease,
+        transform .18s ease,
+        box-shadow .18s ease;
+}
+
+.site-social-link {
+    position: relative;
+
+    display: grid;
+    place-items: center;
+
+    width: 42px;
+    height: 42px;
+
+    border-radius: 50%;
+}
+
+.site-social-link::after {
+    content: attr(aria-label);
+
+    position: absolute;
+    top: 50%;
+    right: calc(100% + 10px);
+
+    width: max-content;
+    max-width: 180px;
+    padding: 6px 9px;
+
+    color: var(--text-color);
+    background-color: var(--nav-bg);
+    border: 1px solid var(--card-border);
+    border-radius: 10px;
+    box-shadow: var(--shadow-card);
+
+    font-size: .74rem;
+    font-weight: 800;
+    line-height: 1.2;
+
+    opacity: 0;
+    visibility: hidden;
+    transform: translate(5px, -50%);
+    pointer-events: none;
+
+    transition:
+        opacity .15s ease,
+        visibility .15s ease,
+        transform .15s ease;
+}
+
+.site-social-link:hover,
+.site-social-link:focus-visible,
+.site-socials-mobile-trigger:hover,
+.site-socials-mobile-trigger:focus-visible,
+.site-socials-mobile[open] > .site-socials-mobile-trigger,
+.site-socials-mobile-link:hover,
+.site-socials-mobile-link:focus-visible {
+    color: var(--primary-color);
+    background-color: var(--notice-bg);
+    border-color: var(--primary-color);
+    box-shadow: 0 7px 18px rgba(179, 94, 175, .18);
+
+    outline: none;
+}
+
+.site-social-link:hover,
+.site-social-link:focus-visible {
+    transform: translateX(-2px) scale(1.04);
+}
+
+.site-social-link:hover::after,
+.site-social-link:focus-visible::after {
+    opacity: 1;
+    visibility: visible;
+    transform: translate(0, -50%);
+}
+
+.site-social-icon,
+.site-socials-mobile-trigger-icon {
+    width: 21px;
+    height: 21px;
+}
+
+.site-socials-mobile {
+    display: none;
+}
+
+html.site-loading-pending .site-socials,
+html.site-loading-visible .site-socials,
+html.site-navigation-loading .site-socials,
+html.site-page-leaving .site-socials {
+    opacity: 0;
+    pointer-events: none;
+}
+
+@media (max-width: 767px) {
+    .site-socials-desktop {
+        display: none;
+    }
+
+    .site-socials-mobile {
+        position: fixed;
+        right: max(14px, env(safe-area-inset-right));
+        bottom: calc(16px + env(safe-area-inset-bottom));
+
+        display: block;
+
+        pointer-events: auto;
+    }
+
+    .site-socials-mobile-trigger {
+        display: grid;
+        place-items: center;
+
+        width: 50px;
+        height: 50px;
+        padding: 0;
+
+        border-radius: 50%;
+        box-shadow: var(--shadow-card);
+
+        backdrop-filter: blur(var(--blur-card));
+        -webkit-backdrop-filter: blur(var(--blur-card));
+
+        cursor: pointer;
+        list-style: none;
+    }
+
+    .site-socials-mobile-trigger::-webkit-details-marker {
+        display: none;
+    }
+
+    .site-socials-mobile-trigger::marker {
+        content: "";
+    }
+
+    .site-socials-mobile-menu {
+        position: absolute;
+        right: 0;
+        bottom: calc(100% + 10px);
+
+        display: grid;
+        gap: 6px;
+
+        min-width: 188px;
+        padding: 8px;
+
+        background-color: var(--nav-bg);
+        border: 1px solid var(--card-border);
+        border-radius: 18px;
+        box-shadow: var(--shadow-card);
+
+        backdrop-filter: blur(var(--blur-card));
+        -webkit-backdrop-filter: blur(var(--blur-card));
+    }
+
+    .site-socials-mobile-link {
+        display: grid;
+        grid-template-columns: 24px minmax(0, 1fr);
+        align-items: center;
+        gap: 10px;
+
+        min-height: 42px;
+        padding: 8px 11px;
+
+        border-radius: 12px;
+
+        color: var(--text-color);
+        font-size: .86rem;
+        font-weight: 800;
+    }
+
+    .site-socials-mobile-link .site-social-icon {
+        color: var(--primary-color);
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .site-socials,
+    .site-social-link,
+    .site-social-link::after,
+    .site-socials-mobile-trigger,
+    .site-socials-mobile-link {
+        transition: none;
+    }
+}
