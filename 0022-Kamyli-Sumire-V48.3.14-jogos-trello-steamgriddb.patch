diff --git a/.github/workflows/sync-jogos.yml b/.github/workflows/sync-jogos.yml
new file mode 100644
index 0000000..9af4f19
--- /dev/null
+++ b/.github/workflows/sync-jogos.yml
@@ -0,0 +1,47 @@
+name: Sync games from Trello
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: "17 9,21 * * *"
+
+permissions:
+  contents: write
+
+concurrency:
+  group: sync-jogos
+  cancel-in-progress: false
+
+jobs:
+  sync:
+    if: github.repository_owner == 'KamyliSouza'
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Sync Trello and SteamGridDB
+        env:
+          TRELLO_API_KEY: ${{ secrets.TRELLO_API_KEY }}
+          TRELLO_TOKEN: ${{ secrets.TRELLO_TOKEN }}
+          STEAMGRIDDB_API_KEY: ${{ secrets.STEAMGRIDDB_API_KEY }}
+          TRELLO_BOARD_ID: IfgV0jXS
+        run: node .github/scripts/sync-jogos.mjs
+
+      - name: Validate generated content
+        run: |
+          python .github/scripts/validate-content.py
+          find js -type f -name '*.js' -print0 | xargs -0 -r -n1 node --check
+          node --check workers.js
+
+      - name: Commit only when content changed
+        run: |
+          if git diff --quiet -- data/content/jogos.json data/content/jogos-artwork-cache.json; then
+            echo "No changes to publish."
+            exit 0
+          fi
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add data/content/jogos.json data/content/jogos-artwork-cache.json
+          git commit -m "chore: sync jogos from Trello"
+          git push
