@@ -0,0 +1,27 @@
+/* JOGOS — V48.3.14. Página nova; reutiliza tokens e superfícies existentes. */
+.jogos-shell { width: min(1120px, calc(100% - 32px)); margin: 28px auto 56px; display: grid; gap: 14px; }
+.jogos-intro { padding: 30px; }
+.jogos-intro h1 { margin: 10px 0 7px; color: var(--primary-color); font-size: clamp(2.1rem, 5vw, 3.25rem); font-weight: 900; line-height: 1.05; letter-spacing: -.035em; }
+.jogos-intro p { max-width: 720px; margin: 0; color: var(--subtitle-color); font-size: .96rem; font-weight: 600; line-height: 1.62; }
+.jogos-tools { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 14px; margin-bottom: 18px; }
+.jogos-filters { display: flex; flex: 1 1 520px; flex-wrap: wrap; gap: 8px; }
+.jogos-filter { min-height: 40px; padding: 8px 13px; color: var(--text-color); background: var(--nav-bg); border: 1px solid var(--card-border); border-radius: 999px; font: inherit; font-size: .84rem; font-weight: 800; cursor: pointer; }
+.jogos-filter[aria-pressed="true"], .jogos-filter:hover, .jogos-filter:focus-visible { color: var(--primary-text); background: var(--primary-soft); border-color: var(--primary-color); outline: none; }
+.jogos-search { flex: 1 1 250px; min-height: 44px; min-width: 0; padding: 0 14px; color: var(--text-color); background: var(--nav-bg); border: 1px solid var(--card-border); border-radius: 14px; font: inherit; font-size: .9rem; font-weight: 700; }
+.jogos-search:focus { border-color: var(--primary-color); box-shadow: 0 0 0 3px var(--primary-soft); outline: none; }
+.jogos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
+.jogo-card { min-width: 0; overflow: hidden; }
+.jogo-card-media { position: relative; aspect-ratio: 2 / 3; overflow: hidden; background: var(--primary-soft); }
+.jogo-card-media::after { content: "🎮"; position: absolute; inset: 0; display: grid; place-items: center; color: var(--subtitle-color); font-size: 2rem; z-index: 0; }
+.jogo-card-media img { position: relative; z-index: 1; width: 100%; height: 100%; display: block; object-fit: cover; }
+.jogo-card-content { display: grid; gap: 7px; padding: 14px; }
+.jogo-card-content h2 { margin: 0; overflow: hidden; color: var(--text-color); font-size: .98rem; font-weight: 900; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
+.jogo-card-status { width: fit-content; max-width: 100%; padding: 5px 9px; overflow: hidden; color: var(--primary-text); background: var(--primary-soft); border-radius: 999px; font-size: .76rem; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
+.jogos-state, .jogos-notice { padding: 18px 20px; }
+.jogos-state { margin: 0; color: var(--subtitle-color); font-weight: 700; text-align: center; }
+.jogos-state[hidden] { display: none; }
+.jogos-notice { margin-top: 4px; }
+.jogos-notice h2 { margin: 0 0 7px; color: var(--text-color); font-size: 1rem; font-weight: 900; }
+.jogos-notice p { margin: 0; color: var(--subtitle-color); font-size: .84rem; font-weight: 600; line-height: 1.6; }
+@media (max-width: 760px) { .jogos-shell { width: min(100% - 24px, 1120px); margin-top: 20px; margin-bottom: 40px; } .jogos-intro { padding: 24px; } .jogos-intro h1 { font-size: 2.15rem; } .jogos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .jogo-card-content { padding: 11px; } }
+@media (max-width: 380px) { .jogos-grid { grid-template-columns: 1fr; } }
