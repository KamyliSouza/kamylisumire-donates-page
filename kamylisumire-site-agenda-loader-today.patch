new file mode 100644
index 0000000..ce2aef5
--- /dev/null
+++ b/css/pages/agenda.css
@@ -0,0 +1,176 @@
+/* AGENDA — V48.3.69. Painel semanal com os sete dias (composição do gerador de PNG). */
+.agenda-shell { width: min(1120px, calc(100% - 32px)); margin: 28px auto 56px; display: grid; gap: 14px; }
+.agenda-intro { padding: 30px; }
+.agenda-intro h1 { margin: 10px 0 7px; color: var(--primary-color); font-size: clamp(2.1rem, 5vw, 3.25rem); font-weight: 900; line-height: 1.05; letter-spacing: -.035em; }
+.agenda-intro p { max-width: 720px; margin: 0; color: var(--subtitle-color); font-size: .96rem; font-weight: 600; line-height: 1.62; }
+.agenda-state { margin: 0; padding: 18px 20px; color: var(--subtitle-color); font-weight: 700; text-align: center; }
+.agenda-state[hidden], .agenda-panel[hidden] { display: none; }
+
+/* ---------- Painel ---------- */
+.agenda-panel {
+    position: relative;
+    isolation: isolate;
+    overflow: hidden;
+    padding: clamp(20px, 3vw, 32px);
+    color: #fff8ff;
+    background: #17131b;
+    border: 1px solid rgba(209, 120, 205, .34);
+    border-radius: 28px;
+    box-shadow: var(--shadow-card);
+}
+/* Fundo panorâmico: arte própria, independente das artes dos cards. */
+.agenda-panel-art { position: absolute; inset: -2px; z-index: -2; pointer-events: none; background-color: #211825; }
+.agenda-panel-art img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 42%; filter: blur(2px) brightness(.66) saturate(.9); transform: scale(1.015); }
+.agenda-panel::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    background:
+        linear-gradient(90deg, rgba(13, 10, 16, .74) 0%, rgba(13, 10, 16, .48) 48%, rgba(13, 10, 16, .28) 100%),
+        linear-gradient(180deg, rgba(10, 8, 13, .22) 0%, rgba(10, 8, 13, .08) 42%, rgba(8, 7, 10, .46) 100%),
+        radial-gradient(ellipse at 4% 95%, rgba(90, 54, 105, .24), transparent 42%);
+}
+.agenda-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 17px; border-bottom: 1px solid rgba(209, 120, 205, .42); }
+.agenda-panel-head h2 { margin: 0; font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 900; letter-spacing: .025em; text-transform: uppercase; text-shadow: 0 2px 14px rgba(0, 0, 0, .55); }
+.agenda-period { margin: 0; padding: 7px 11px; color: #f0dcef; background: rgba(25, 16, 29, .58); border: 1px solid rgba(209, 120, 205, .38); border-radius: 999px; box-shadow: 0 3px 14px rgba(0, 0, 0, .15); font-size: .85rem; font-weight: 850; white-space: nowrap; }
+.agenda-days { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 21px; }
+.agenda-panel-foot { display: flex; justify-content: space-between; gap: 14px; margin-top: 19px; padding-top: 14px; color: #e0d3e3; border-top: 1px solid rgba(255, 255, 255, .18); font-size: .75rem; line-height: 1.45; text-shadow: 0 1px 8px rgba(0, 0, 0, .5); }
+.agenda-panel-foot p { margin: 0; }
+.agenda-panel-foot strong { color: #f0dcef; font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; }
+
+/* ---------- Cards dos dias ---------- */
+.agenda-day {
+    position: relative;
+    isolation: isolate;
+    /* width explícita: sem ela, min-height + aspect-ratio empurram a largura além da coluna. */
+    width: 100%;
+    min-width: 0;
+    min-height: 228px;
+    aspect-ratio: 478 / 238;
+    overflow: hidden;
+    display: flex;
+    flex-direction: column;
+    justify-content: space-between;
+    padding: 18px 21px 17px;
+    color: #fff;
+    background: linear-gradient(135deg, #64446a, #251c31 70%);
+    border: 1px solid rgba(209, 120, 205, .48);
+    border-radius: 23px;
+}
+.agenda-day.has-multiple-lives { aspect-ratio: auto; }
+.agenda-day:last-child { grid-column: 1 / -1; width: calc((100% - 16px) / 2); justify-self: center; }
+/* A arte do jogo ocupa todo o card (cover, sem distorcer). */
+.agenda-day-art { position: absolute; inset: 0; z-index: -2; }
+.agenda-day-art img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 44%; transform: scale(1.005); }
+/* Véu geral leve e degradê inferior forte, como no gerador. */
+.agenda-day.has-live::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    background:
+        linear-gradient(180deg, rgba(7, 5, 10, .36) 0%, rgba(7, 5, 10, .17) 28%, rgba(7, 5, 10, .52) 56%, rgba(7, 5, 10, .94) 100%),
+        linear-gradient(90deg, rgba(7, 5, 10, .22), transparent 76%);
+}
+.agenda-day-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; min-width: 0; }
+.agenda-day-name { margin: 0; font-size: .92rem; font-weight: 950; letter-spacing: .035em; line-height: 1.2; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0, 0, 0, .8); }
+.agenda-day-date { display: block; margin-top: 4px; color: #e0d0e2; font-size: .76rem; text-shadow: 0 2px 10px rgba(0, 0, 0, .8); }
+.agenda-chip { flex: none; padding: 5px 9px; color: #ffd7fa; background: rgba(36, 19, 39, .82); border: 1px solid rgba(230, 154, 222, .62); border-radius: 999px; box-shadow: 0 2px 9px rgba(0, 0, 0, .25); font-size: .64rem; font-weight: 950; letter-spacing: .045em; white-space: nowrap; }
+.agenda-event-info { display: grid; gap: 9px; min-width: 0; margin-top: auto; padding-top: 26px; }
+.agenda-event { min-width: 0; }
+.agenda-event-line { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.agenda-time { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; min-width: 68px; padding: 6px 9px; color: #ffe3fb; background: rgba(55, 30, 60, .91); border: 1px solid rgba(220, 146, 214, .62); border-radius: 10px; box-shadow: 0 2px 10px rgba(0, 0, 0, .22); font-size: .76rem; font-weight: 950; }
+.agenda-event-title { min-width: 0; margin: 0; color: #fffaff; font-size: clamp(1.02rem, 1.6vw, 1.2rem); font-weight: 950; line-height: 1.12; overflow-wrap: anywhere; text-shadow: 0 2px 12px rgba(0, 0, 0, .95); }
+.agenda-event-description { margin: 7px 0 0; color: #e6d8e8; font-size: .76rem; line-height: 1.35; text-shadow: 0 2px 9px rgba(0, 0, 0, .8); }
+.agenda-platforms { margin: 8px 0 0; color: #d6c3d8; font-size: .69rem; font-weight: 800; text-shadow: 0 2px 9px rgba(0, 0, 0, .8); }
+
+/*
+ * Dia sem live: mesmo padrão de placeholder de /jogos/ — superfície translúcida
+ * com halo da cor primária e a marca do site como máscara. O desfoque usa
+ * --blur-card, então respeita Blur desligado, Save-Data e modo leitura.
+ */
+.agenda-day.no-live { color: #c9bdcc; background: transparent; border-color: rgba(209, 120, 205, .28); }
+.agenda-day.no-live::before {
+    content: "";
+    position: absolute;
+    inset: -3px;
+    z-index: -2;
+    background:
+        radial-gradient(circle at 50% 46%, var(--primary-soft), transparent 59%),
+        linear-gradient(145deg, rgba(34, 27, 38, .68), rgba(20, 17, 24, .78));
+    -webkit-backdrop-filter: blur(calc(var(--blur-card) * 1.3)) saturate(115%);
+    backdrop-filter: blur(calc(var(--blur-card) * 1.3)) saturate(115%);
+}
+.agenda-day.no-live::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    background:
+        radial-gradient(circle at 50% 48%, rgba(209, 120, 205, .08), transparent 58%),
+        linear-gradient(180deg, rgba(8, 7, 10, .12), rgba(8, 7, 10, .30));
+}
+.agenda-day-placeholder { flex: 1; min-height: 0; display: grid; place-content: center; justify-items: center; gap: 10px; padding: 12px 6px 2px; text-align: center; }
+.agenda-day-mark {
+    width: 58px;
+    height: 58px;
+    display: block;
+    background: var(--primary-color);
+    -webkit-mask: url('https://assets.kamylisumire.com/logo.webp') center / contain no-repeat;
+    mask: url('https://assets.kamylisumire.com/logo.webp') center / contain no-repeat;
+    filter: drop-shadow(0 6px 16px var(--primary-soft));
+    opacity: .86;
+}
+.agenda-day-placeholder-copy .agenda-event-title { color: #f0e6f0; font-size: 1.04rem; text-shadow: 0 2px 10px rgba(0, 0, 0, .5); }
+.agenda-day-placeholder-copy .agenda-event-description { margin-top: 4px; color: #d0c1d2; text-shadow: 0 2px 9px rgba(0, 0, 0, .42); }
+@supports not ((mask-image: url("")) or (-webkit-mask-image: url(""))) {
+    .agenda-day-mark { background: transparent url('https://assets.kamylisumire.com/logo.webp') center / contain no-repeat; }
+}
+:root[data-blur="off"] .agenda-day.no-live::before { -webkit-backdrop-filter: none; backdrop-filter: none; background: linear-gradient(145deg, rgba(34, 27, 38, .94), rgba(20, 17, 24, .96)); }
+
+/* ---------- Aviso legal ---------- */
+.agenda-legal { padding: 18px 20px; }
+.agenda-legal h2 { margin: 0 0 7px; color: var(--text-color); font-size: 1rem; font-weight: 900; }
+.agenda-legal p { margin: 0; color: var(--subtitle-color); font-size: .84rem; font-weight: 600; line-height: 1.6; }
+
+/* ---------- Movimento ---------- */
+@media (prefers-reduced-motion: no-preference) {
+    .agenda-day { transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
+    .agenda-day:hover { transform: translateY(-2px); border-color: rgba(235, 170, 232, .9); box-shadow: 0 12px 28px rgba(0, 0, 0, .28); }
+}
+
+/* ---------- Responsivo (o dock de redes ocupa a lateral esquerda até 1279 px) ---------- */
+@media (min-width: 768px) and (max-width: 1279px) {
+    .agenda-shell { width: min(1120px, calc(100% - 104px)); margin-left: 76px; margin-right: 28px; }
+}
+@media (min-width: 768px) and (max-width: 1024px) {
+    .agenda-panel { padding: clamp(18px, 2.5vw, 26px); }
+    .agenda-days { gap: 13px; }
+    .agenda-day { min-height: 205px; padding: 16px 17px; }
+    .agenda-day:last-child { width: calc((100% - 13px) / 2); }
+    .agenda-day-name { font-size: .86rem; }
+    .agenda-event-title { font-size: clamp(.98rem, 1.7vw, 1.12rem); }
+}
+@media (max-width: 767px) {
+    .agenda-shell { width: calc(100% - 24px); margin-top: 20px; margin-bottom: 40px; }
+    .agenda-intro { padding: 24px; }
+    .agenda-intro h1 { font-size: 2.15rem; }
+    .agenda-days { grid-template-columns: 1fr; gap: 13px; }
+    .agenda-day, .agenda-day:last-child { grid-column: auto; width: 100%; min-height: 190px; }
+    .agenda-panel-head { flex-direction: column; align-items: flex-start; }
+    .agenda-period { white-space: normal; }
+    .agenda-panel-foot { flex-direction: column; }
+}
+@media (max-width: 540px) {
+    .agenda-panel { padding: 17px; border-radius: 22px; }
+    .agenda-day, .agenda-day:last-child { min-height: 180px; padding: 15px 16px; }
+    .agenda-day-name { font-size: .9rem; }
+    .agenda-event-title { font-size: 1.04rem; }
+    .agenda-day-mark { width: 52px; height: 52px; }
+    .agenda-day-placeholder { gap: 8px; }
+    .agenda-panel-foot { font-size: .72rem; }
+}
