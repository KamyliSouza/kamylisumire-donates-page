+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        for name, _value in attrs:
+            lowered = name.lower()
+            if lowered == "style":
+                self.inline_style = True
+            elif lowered.startswith("on"):
+                self.inline_handler = True
+
+    handle_startendtag = handle_starttag
 
 
